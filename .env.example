# =============================================================
# Frontend (Vite) - Jtech - Variáveis de ambiente
# Copie para .env (dev) ou .env.production (build de produção):
#   cp .env.example .env
# Apenas variáveis com prefixo VITE_ chegam ao bundle — não coloque
# segredos aqui, tudo fica visível no navegador.
# =============================================================

# ---------------------------
# CMS (Strapi)
# Dev:  http://localhost:1337
# Prod: https://cms.jtech.com.br
# ---------------------------
VITE_CMS_URL=http://localhost:1337

# ---------------------------
# Google Tag Manager (opcional)
# Sem valor, o GTM não é carregado.
# ---------------------------
VITE_GTM_ID=GTM-XXXXXXX

# ---------------------------
# Envio de leads
# "disabled" (padrão) = nada é enviado; os formulários avisam indisponibilidade
# "mock"              = apenas loga no console (desenvolvimento)
# "n8n_webhook"       = envia para VITE_N8N_LEAD_WEBHOOK
# ---------------------------
VITE_LEADS_TRANSPORT=disabled

# Endereço de produção do fluxo de leads publicado no n8n.
# É esse fluxo que registra a conversão na RD Station, usando o form_name do
# payload como conversion_identifier.
# Precisa conter /webhook/ — /webhook-test/ só responde com o editor aberto.
VITE_N8N_LEAD_WEBHOOK=
