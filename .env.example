# =============================================================
# Frontend (Vite) - Jtech - Variáveis de ambiente
# Copie para .env (dev) ou .env.production (build de produção):
#   cp .env.example .env
# Apenas variáveis com prefixo VITE_ chegam ao bundle — não coloque
# segredos aqui, tudo fica visível no navegador.
# =============================================================

# ---------------------------
# CMS (Strapi)
# Dev:  http://localhost:1337
# Prod: https://cms.jtech.com.br
# ---------------------------
VITE_CMS_URL=http://localhost:1337

# ---------------------------
# Google Tag Manager (opcional)
# Sem valor, o GTM não é carregado.
# ---------------------------
VITE_GTM_ID=GTM-XXXXXXX
